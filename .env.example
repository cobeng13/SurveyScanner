# Install as .env on apps-server. Use the actual Access application settings.
SURVEY_PUBLIC_ORIGIN=https://survey.example.edu
SURVEY_CF_TEAM=your-team.cloudflareaccess.com
SURVEY_CF_AUD=
SURVEY_BIND_ADDRESS=127.0.0.1
SURVEY_HOST_PORT=8008
SURVEY_ROOT_PATH=
SURVEY_TRUSTED_PROXY_IPS=127.0.0.1

SURVEY_MAX_UPLOAD_MB=50
SURVEY_MAX_PAGES=40
SURVEY_MAX_RASTER_MP=420
SURVEY_CONCURRENCY=1
SURVEY_JOB_TIMEOUT=900
SURVEY_WEB_TEMP=256m
SURVEY_WEB_MEMORY=768m
SURVEY_WORKER_MEMORY=1500m
SURVEY_VOLUME_NAME=survey-scanner-data
